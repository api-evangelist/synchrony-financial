{
  "opencollection": "1.0.0",
  "info": {
    "name": "Synchrony Financial Credit Authorization Applications API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit Credit Application",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syf.com/v1/credit/applications",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submits a full credit card application for a customer. The customer receives an instant decision and access to their credit line upon approval. Supports web and mobile (mApply) channels."
        }
      ]
    }
  ],
  "bundled": true
}